# ==============================================================================
# Environment Configuration - DSA Revision and Mastery Platform
# ==============================================================================
# Copy this file to .env or .env.local and fill in the values for your local environment:
#   cp .env.example .env
#
# IMPORTANT:
# - Never commit actual .env or .env.local files containing production or secret credentials.
# - Do not prefix database connection strings with NEXT_PUBLIC_ to prevent leaking to client bundles.
# ==============================================================================

# Node Environment
NODE_ENV="development"

# PostgreSQL Connection String (Prisma ORM)
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=<SCHEMA>
#
# Local PostgreSQL Default:
#   postgresql://postgres:postgres@localhost:5432/dsa_tracker?schema=public
#
# Docker Compose Example:
#   postgresql://postgres:postgres@localhost:5432/dsa_tracker?schema=public
#
# Hosted Provider (Supabase, Neon, Railway):
#   postgresql://user:password@ep-cool-db.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dsa_tracker?schema=public"
